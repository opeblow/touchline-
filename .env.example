# Touchline configuration. Copy to .env. Everything is optional: with nothing set,
# Touchline runs fully offline (in-process bus, WebSockets, verified template writer).

# --- Microsoft Foundry (preferred). Uses Entra ID (az login / managed identity).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_FAST=gpt-4.1-mini
FOUNDRY_MODEL_REASONING=gpt-4.1

# --- or Azure OpenAI / OpenAI-compatible
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Azure data plane (managed identity in Azure; connection strings work locally)
EVENTHUB_CONNECTION=
EVENTHUB_FQDN=
EVENTHUB_NAME=match-events
COSMOS_ENDPOINT=
COSMOS_KEY=
WEBPUBSUB_CONNECTION=
WEBPUBSUB_ENDPOINT=
TRANSLATOR_KEY=
TRANSLATOR_REGION=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
SEARCH_ENDPOINT=
SEARCH_KEY=
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOGIC_APP_RECAP_URL=

# --- App
DEMO_SPEED=8
LANGUAGES=en,es,fr,pt,ar,ja

# --- Foundry managed agents (after: python -m touchline.foundry_ops register)
FOUNDRY_HOSTED_AGENTS=false

# --- Enterprise controls
CONTROL_API_KEY=            # when set, control actions need header x-touchline-key
MAX_COST_PER_MATCH_USD=2.0  # agents fall back to verified templates beyond this spend
ASK_RATE_PER_MINUTE=20
CHAT_MIN_INTERVAL_S=1.0
